{
  "name": "daybook-demo-self-hosted",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "wrangler deploy --dry-run",
    "db:local": "wrangler d1 execute DB --local --file schema.sql",
    "db:remote": "wrangler d1 execute DB --remote --file schema.sql",
    "smoke": "node smoke-check.mjs"
  },
  "devDependencies": {
    "wrangler": "4.166.0"
  },
  "engines": {
    "node": ">=22"
  }
}
