{
  "name": "my-daybook",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-23",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "NODE_ENV": "production",
    "TZ": "America/New_York",
    "ENABLE_AI": "false"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "my-daybook-db",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "ratelimits": [
    {
      "name": "ESTIMATE_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "LOGIN_LIMIT",
      "namespace_id": "1002",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
